{
  "name": "steadydose",
  "version": "0.1.0",
  "private": true,
  "description": "SteadyDose — local-first medication adjusted-dose tracker (PWA) with a secure, server-readable cloud.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mocked": "playwright test --config=playwright.mocked.config.ts",
    "test:e2e:coverage": "COVERAGE=true playwright test",
    "test:e2e:mocked:coverage": "COVERAGE=true playwright test --config=playwright.mocked.config.ts",
    "agent:measure": "python3 scripts/measure-agent-tokens.py",
    "agent:preflight": "./scripts/agent-preflight.sh",
    "agent:bootstrap": "./scripts/agent-bootstrap.sh",
    "agent:ratchet": "node scripts/agent/ratchet.mjs",
    "agent:run": "./scripts/agent-run.sh",
    "agent:report": "node scripts/agent/run-report.mjs",
    "agent:doctrine": "node scripts/agent/doctrine.mjs",
    "agent:rubric": "node scripts/agent/rubric.mjs",
    "agent:test": "vitest run --config vitest.agent.config.ts",
    "agent:test:coverage": "vitest run --coverage --config vitest.agent.config.ts",
    "agent:audit": "node scripts/agent-audit.mjs",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage": "pnpm test:coverage && pnpm test:e2e:coverage && pnpm test:e2e:mocked:coverage && pnpm coverage:merge",
    "coverage:ci": "pnpm test:coverage && pnpm test:e2e:mocked:coverage && pnpm coverage:merge",
    "local:up": "supabase start",
    "local:down": "supabase stop",
    "local:reset": "supabase db reset",
    "local:env": "node scripts/write-env.mjs",
    "db:test": "supabase test db",
    "deploy:db": "supabase db push",
    "deploy": "pnpm deploy:db && pnpm build && pnpm dlx wrangler pages deploy dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@supabase/supabase-js": "^2.111.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@react-aria/test-utils": "1.0.0-rc.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "badge-maker": "^6.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "fallow": "2.104.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.2.0",
    "monocart-coverage-reports": "^2.12.12",
    "monocart-reporter": "^2.12.4",
    "pg": "^8.22.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "vitest-monocart-coverage": "^2.1.3",
    "workbox-precaching": "7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
