{
  "name": "steadydose",
  "version": "0.1.0",
  "private": true,
  "description": "SteadyDose — local-first, end-to-end-encrypted medication adjusted-dose tracker (PWA).",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.infra.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:bootstrap": "tsx infra/local/bootstrap.ts",
    "local:api": "tsx watch infra/local/server.ts",
    "local:reset": "docker compose down -v && rm -rf .localstack .cognito infra/local/local-config.json",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --outputs-file cdk-outputs.json --require-approval never",
    "cdk:destroy": "cdk destroy",
    "infra:gen-config": "tsx infra/cdk/genConfig.ts",
    "deploy:host": "tsx infra/cdk/host.ts",
    "deploy": "pnpm cdk:deploy && pnpm infra:gen-config && pnpm build && pnpm deploy:host",
    "prepare": "husky"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.12",
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.717.0",
    "@aws-sdk/client-dynamodb": "^3.717.0",
    "@aws-sdk/lib-dynamodb": "^3.717.0",
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@testing-library/jest-dom": "^6.6.3",
    "aws-cdk": "^2.173.4",
    "aws-cdk-lib": "^2.173.4",
    "constructs": "^10.4.2",
    "cors": "^2.8.5",
    "esbuild": "^0.24.2",
    "express": "^5.0.1",
    "jose": "^5.9.6",
    "tsx": "^4.19.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
