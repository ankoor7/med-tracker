.playwright-mcp/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vite PWA generated artifacts
dev-dist/

# Supabase CLI local stack (Docker volumes + generated artifacts)
supabase/.temp/
supabase/.branches/

# Stray local files
files/
files.zip
