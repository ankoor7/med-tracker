# SteadyDose environment configuration (example).
# These are only needed from Stage 3 onward (AWS backend & auth).
# Stages 0–2 run fully offline with no env required.
#
# For LOCAL dev you don't fill this in by hand: `pnpm local:bootstrap`
# generates .env.local for you (LocalStack + cognito-local).
# For a real deploy, the config generator writes these from CDK outputs.
# NEVER commit real values — only this example file is tracked.

# Cognito (Stage 3+)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
# Set ONLY for local dev (cognito-local). Leave empty for real AWS.
VITE_COGNITO_ENDPOINT=

# API Gateway sync endpoint (Stage 3+)
VITE_API_BASE_URL=
