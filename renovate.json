{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group non-major JS dependency updates into one PR per week; majors stay ungrouped (Renovate default) for individual review",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Group GitHub Actions updates separately from app dependencies",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Supabase CLI version affects supabase/config.toml compatibility; keep it out of the grouped PR for individual review",
      "matchManagers": ["npm"],
      "matchPackageNames": ["supabase"],
      "groupName": "supabase",
      "labels": ["dependencies", "supabase"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"]
  }
}
